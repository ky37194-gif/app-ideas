<?xml version="1.0" encoding="utf-8"?>
<!-- Android wrapper for App Ideas Tracker: a full-screen WebView that opens the live site -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ky.appideas">

    <!-- Needed to load the site and sync -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="App Ideas"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-press icon shortcuts: ⚡ Jaldi likho, 📥 Inbox -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!-- Home-screen widget: ⚡ Jaldi idea likho -->
        <receiver android:name=".QuickWidget" android:exported="false" android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_quick_info" />
        </receiver>
    </application>
</manifest>
